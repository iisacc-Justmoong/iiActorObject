  },
  "implemented": [
    "canonical source-point selection, neighbour growth, smoothing and set operations",
    "Euclidean and original-edge-graph surface-distance footprints",
    "pressure, four falloff kernels, source masks and bounded stroke work",
    "multi-sample sculpt and arbitrary-plane symmetry without doubled seam displacement",
    "replace/add/subtract and whole-row Jacobi skin smoothing",
    "locked influences, explicit fallback, optional influence cap and atomic failure",
    "one history entry per effective stroke and no-op revision preservation",
    "immutable shared per-layer point masks affecting position/skin/morph deltas",
    "masked body edits retain garment following",
    "native project version 3, shared mask dictionaries and versions 1/2 input",
    "thin borrowed NSCharacter wrappers and installed core/shared/static consumers"
  ],
