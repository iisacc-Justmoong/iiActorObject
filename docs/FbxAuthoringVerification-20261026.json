  "implemented": [
    "source control point, UV and normal IDs, unused attributes and polygon preservation",
    "one authoring mesh per node instance with polygon material IDs",
    "derived triangle-to-polygon and material mappings",
    "material-grouped GLB primitives over shared attributes and morphs",
    "standard FBX control points and polygons with indexed UVs/normals",
    "validated raw-blob authoring metadata for hidden faces, layouts and empty skin rows",
    "logical morph names and source target IDs restored by SDK metadata",
    "static and reflected mesh handling and unreferenced normal magnitude retention",
    "DNA-to-edited-FBX-to-DNA source identity and behavior verification"
  ],
