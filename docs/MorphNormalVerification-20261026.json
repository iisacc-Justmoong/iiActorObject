  "milestone": "Core-owned explicit morph normal authoring, layers, skinning, FBX/GLB fidelity and DNA loss policy",
  "overallGoalStatus": "active and incomplete",
  "repositoryBaseRevision": "21e4dc163ef1505ebdffd2ebf8104f12ed48faf1",
  "platform": "Darwin arm64",
  "ownership": {
    "engine": "iiActorObject::Object3DEngine",
    "coreResources": [
      "assets and authored normals",
      "editing sessions and layer history",
      "rig source/program/execution buffers",
      "template neutral source, sparse targets and joint anchors"
    ],
    "NSCharacter": "borrowed handles only",
    "implicitGlobalEngine": false,
    "coreIncludesNSCharacter": false
  },
  "implemented": [
    "optional sparse normal deltas keyed by original layout IDs",
    "derived, explicit empty and explicit nonempty normal semantics",
    "normal-only morphs and source-target aggregation",
    "linear normal coefficients preserved before final normalization and inverse-transpose skinning",
    "layer interpolation, template recalculation and undo",
    "artist base normals preserved for surface-preserving edits",
    "standard FBX raw normal conversion including nonuniform reflection",
    "strict FBX representability and explicit metadata projection option",
    "metadata stale-normal rejection and standard-import opt-out",
    "sparse GLB NORMAL accessor verified by independent parser",
    "DNA strict rejection or explicit warned discard of differing morph normals"
  ],
  "normalTests": [
    "iiActorObject.morph_normals.rendering",
