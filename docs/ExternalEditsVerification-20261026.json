  "implemented": [
    "optional FBX stable-ID user properties with per-point/face/corner Blender INT attributes",
    "mesh/point/joint reorder and display-name preservation",
    "source document/schema/correspondence validation and transactional conflicts",
    "baseline-to-edited additive point/UV/material/morph differences on the current parametric state",
    "source-ID skin goals and joint linear-frame deltas with parent/name changes",
    "original source scale and source joint-frame retention",
    "original morph target IDs, renames, additions, explicit normal coefficients and empty deleted targets",
    "replaceable external edit layers retaining ID/order/weight/mask and upper layers",
    "exact final-frame inverse surface-following for multi-layer garments",
    "project undo/redo and parameter changes after actual Blender FBX edits",
    "source PBR scalars restored once during Blender import, with actual final roughness validation",
    "strict default FBX matrix precision plus explicitly bounded near-TRS import/merge measurements",
    "independent installed shared/core/no-DNA/static consumers and borrowed NSCharacter wrappers"
  ],
