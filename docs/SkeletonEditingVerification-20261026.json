  "implemented": [
    "stable source bone IDs and explicit parent-first evaluation order",
    "iterative validation and dirty propagation for forward-parent hierarchies",
    "local/object bind TRS editing with full direct-child transform preservation",
    "object-space Y-axis aiming with explicit roll hint",
    "stable-ID reparenting with preserve-world or preserve-local policies",
    "negative and nonuniform local scale support with exact TRS/shear rejection",
    "world position/rotation and local scale correction layers with discrete parent overrides",
    "transactional cyclic layer-state and zero-scale rejection",
    "native project version 4 and versions 1/2/3 input including v3 point masks",
    "sequential project rig-layer validation for dependency-sensitive parents",
    "FBX preallocated joint node IDs fix for forward-parent references",
    "original-file geometry and joint reference validation in actual Blender",
    "borrowed NSCharacter entry points and separate installed consumers",
    "reversible uniform bind-scale coordinate conversion and 24 arbitrary-pose combinations",
    "source scale restoration after reordered/reparented unit-skeleton edits",
    "bounded text scale profile codec and separate original/unit application exports"
  ],
