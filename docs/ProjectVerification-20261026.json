  "ownership": {
    "engine": "iiActorObject::Object3DEngine",
    "coreResources": [
      "assets and authored normals",
      "editing sessions and layer history",
      "rig source/program/execution buffers",
      "template neutral source, sparse targets and joint anchors"
    ],
    "NSCharacter": "borrowed handles only",
    "implicitGlobalEngine": false,
    "coreIncludesNSCharacter": false
  },
  "implemented": [
    "self-contained authored assets, unused IDs and explicit normals",
    "native runtime mesh persistence",
    "template target catalog, ranges and joint anchors",
    "layer parameters, ordering, IDs, weights and disabled corrections",
    "full undo/redo interval, cursor, revision and next-layer identity",
    "deduplicated shared immutable layouts and original triangulation",
    "structural oriented-boundary/internal-edge/diagonal validation",
    "selected native DNA sources, per-session joint mappings and multi-LOD bindings",
    "transactional import rollback of existing resources and next IDs",
    "strict version, length, CRC, numeric, reference and allocation admission",
    "independent zlib envelope and malformed-input verification",
    "borrowed NSCharacter project wrappers"
  ],
