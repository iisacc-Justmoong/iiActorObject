    "coreIncludesNSCharacter": false
  },
  "implemented": [
    "canonical source-point auto-binding fix and render cache refresh",
    "immutable BVH nearest-surface queries with barycentric results",
    "source-name/explicit bone-map skin transfer without implicit influence truncation",
    "strict distance/skip policy and transactional data edits",
    "opposite-half-space clipping and involutive bone symmetry",
    "DAG surface followers preserving local frame offsets",
    "body and garment parameter/sculpt correction composition",
    "editable attachment after existing shape edits and parameter choices",
    "mixed-template undo/redo and persistent surface bindings",
    "automatic rebind removes stale foreign skeleton influences",
    "native project version 2 and legacy version 1 input",
    "borrowed NSCharacter interfaces and installed consumers"
  ],
